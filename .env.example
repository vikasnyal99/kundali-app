# Copy to .env (never commit it). Names only; every value here is a non-secret placeholder.
APP_ENV=development
# SQLite is for quick local UI work only; integration tests and deployment use PostgreSQL, e.g.
# postgresql+psycopg://kundli:local-dev-only@127.0.0.1:55432/kundli  (infra/compose.dev.yml)
DATABASE_URL=sqlite:///./kundli.db
# Production: random, >= 40 characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=development-only-change-before-deployment
# Private S3-compatible bucket. Leave S3_ENDPOINT_URL empty for AWS S3.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AES256 (SSE-S3) by default; set empty only if the store rejects the header and encrypts at rest itself.
S3_SSE=AES256
REPORT_PRESIGN_TTL_SECONDS=300
# Comma-separated exact origins (production: https:// only, no wildcard). Native mobile apps do not need CORS.
CORS_ORIGINS=http://localhost:8080
# Address(es) of the reverse proxy as seen by the API container (Docker gateway); enables real client IPs for rate limits.
FORWARDED_ALLOW_IPS=127.0.0.1
API_HOST_PORT=8100
WORKER_POLL_SECONDS=1
JOB_MAX_ATTEMPTS=3
JOB_LEASE_MINUTES=10
JOB_RETENTION_DAYS=14
# Optional validated calculation service; see docs/ENGINE_RESEARCH.md.
ASTROLOGY_URL=
ASTROLOGY_API_KEY=
ASTROLOGY_ENGINE_VERSION=unconfigured
# For local evaluation after installing server/requirements-engine.txt:
# ASTROLOGY_MODE=local_experimental
ASTROLOGY_MODE=disabled
# Do not set true until licensing is decided AND domain-reviewed fixtures pass. Setting it is not validation.
ASTROLOGY_RELEASE_APPROVED=false
# AI explanations (optional; not used for scores). Set only in the server's .env, never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
